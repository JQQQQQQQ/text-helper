<Window x:Class="TextHelper.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextHelper"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <Border BorderBrush="#4A90D9" BorderThickness="2" CornerRadius="12" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="3" Color="Black"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📖 TextHelper" FontSize="14" FontWeight="Bold"
                           Foreground="#4A90D9" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="✕" Width="24" Height="24"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#999" FontSize="14"
                        Click="CloseButton_Click"
                        Cursor="Hand"/>
            </Grid>

            <!-- 原文 -->
            <Border Grid.Row="1" Background="#F5F7FA" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <TextBlock x:Name="OriginalText" TextWrapping="Wrap" FontSize="14"
                           Foreground="#333" FontWeight="SemiBold"/>
            </Border>

            <!-- 翻译 -->
            <Border Grid.Row="2" Background="#E8F5E9" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TranslationText" Grid.Row="0"
                               TextWrapping="Wrap" FontSize="16"
                               Foreground="#2E7D32" FontWeight="Bold"/>
                    <TextBlock x:Name="ExplanationText" Grid.Row="1"
                               TextWrapping="Wrap" FontSize="13"
                               Foreground="#555" Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <!-- 例句 -->
            <ItemsControl x:Name="ExamplesList" Grid.Row="3" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF3E0" CornerRadius="6" Padding="10,6" Margin="0,2">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#E65100" FontStyle="Italic"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SpeakButton" Content="🔊 朗读" Margin="0,0,8,0"
                        Padding="10,4" FontSize="12"
                        Background="#4A90D9" Foreground="White" BorderThickness="0"
                        Cursor="Hand"
                        Click="SpeakButton_Click"/>
                <Button Content="📋 复制译文" Padding="10,4" FontSize="12"
                        Background="#F5F5F5" BorderThickness="1" BorderBrush="#DDD"
                        Cursor="Hand"
                        Click="CopyButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
